# Cloudflare Turnstile — desafio anti-robô do cadastro público (/cadastro).
# Sem essas duas, o cadastro continua funcionando (só com o rate limit por IP).
# Crie em dash.cloudflare.com > Turnstile > Add site.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secreta — nunca prefixar com NEXT_PUBLIC_. Usada só em Server Actions
# (ex: convidar aluno via Supabase Auth admin). Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Notificações push — gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# E-mail de boas-vindas no cadastro público (/cadastro) — crie a chave em
# resend.com → API Keys. Sem essa chave, o cadastro continua funcionando
# normal, só não manda o e-mail (a senha aparece na tela como reforço).
RESEND_API_KEY=your-resend-api-key

# Strava (opcional — sem as chaves o recurso fica invisivel)
# Criar app em strava.com/settings/api, callback domain = app.marchewskiassessoria.com
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# token qualquer (aleatorio) usado na validacao da inscricao do webhook
STRAVA_WEBHOOK_VERIFY_TOKEN=
